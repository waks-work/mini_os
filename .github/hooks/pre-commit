#!/bin/bash
set -e

echo "🕵️  Running mini_os pre-commit safety checks..."

# 1. Format Check (C and Zig)
if command -v clang-format &> /dev/null; then
    find kernel boot driver -name "*.c" -o -name "*.h" | xargs clang-format -i
fi

if command -v zig &> /dev/null; then
    zig fmt build.zig
fi

# 2. Static Analysis for the Kernel
if command -v cppcheck &> /dev/null; then
    cppcheck --enable=all --suppress=missingIncludeSystem -I ../waks_cstd/include kernel/
fi

# 3. Dry-Run Build
echo "🏗️  Verifying freestanding build..."
zig build

echo "✅ Ready for the Silicon. Commit successful."
